# 6 "/home/kongchen/Project/STM32_F401_Basic_Framework/boards/others/stm32_f401_dev/stm32_f401_dev.dts" 2

/ {
    model = "STM32_f401_dev board";
    compatible = "st,stm32_f401_dev";

    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
    };

    aliases {
        led0 = &user_led;
        sw0 = &user_button0;
        sw1 = &user_button1;
    };

    leds {
        compatible = "gpio-leds";

        user_led: led-1 {
            gpios = <&gpioc 13 (1 << 0)>;
            label = "LD";
        };
    };

    gpio_keys {
        compatible = "gpio-keys";

        user_button0: button-1 {
            gpios = <&gpioc 0 ((1 << 0) | (1 << 4))>;
            zephyr,code = <11>;
            label = "KEY0";
        };

        user_button1: button-2 {
            gpios = <&gpioc 1 ((1 << 0) | (1 << 4))>;
            zephyr,code = <2>;
            label = "KEY1";
        };
    };
};

&clk_lsi {
    status = "okay";
};

&clk_hse {
    clock-frequency = <(((25) * 1000) * 1000)>;
    status = "okay";
};

&pll {
    div-m = <25>;
    mul-n = <336>;
    div-p = <4>;
    div-q = <7>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <(((84) * 1000) * 1000)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <2>;
    apb2-prescaler = <1>;
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};
