/dts-v1/;

#include <st/f4/stm32f401Xe.dtsi>
#include <st/f4/stm32f401r(d-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
    model = "STM32_f401_dev board";
    compatible = "st,stm32_f401_dev";

    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,display = &ssd1306;
    };

    aliases {
        led0 = &user_led;
        sw0 = &user_button0;
        sw1 = &user_button1;
    };

    leds {
        compatible = "gpio-leds";

        user_led: led-1 {
            gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
            label = "LD";
        };
    };

    gpio_keys {
        compatible = "gpio-keys";

        user_button0: button-1 {
            gpios = <&gpioc 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_0>;
            label = "KEY0";
        };

        user_button1: button-2 {
            gpios = <&gpioc 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_1>;
            label = "KEY1";
        };
    };

    led_strip {
        compatible = "led-strip-container";
        
        user_ws2812_1: ws2812_1 {
            compatible = "worldsemi_ws2812_pwm";
            pwms = <&pwm5 3 1250 PWM_POLARITY_NORMAL>;
            dmas = <&dma1 0 6 STM32_DMA_PERIPH_TX STM32_DMA_16BITS>;
            dma-names = "update";
            chain-length = <1>;
            color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
            zero-pulse-ns = <420>;
            one-pulse-ns = <830>;
            reset-delay = <80>;
        };
    };
};

&clk_lsi {
    status = "okay";
};

&clk_hse {
    clock-frequency = <DT_FREQ_M(25)>; /* 25MHz passive crystal */
    status = "okay";
};

&pll {
    div-m = <25>;
    mul-n = <336>;
    div-p = <4>;
    div-q = <7>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(84)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <2>;
    apb2-prescaler = <1>;
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

&i2c1 {
    pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    status = "okay";

    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <0x3f>;
        segment-remap;
        prechargep = <0x22>;
        /* 开启软件复位*/
        softreset-on;
    };
};

&timers5 {
	status = "okay";

	pwm5: pwm {
		status = "okay";
		pinctrl-0 = <&tim5_ch3_pa2>;
		pinctrl-names = "default";
	};
};

&dma1 {
	status = "okay";
};
