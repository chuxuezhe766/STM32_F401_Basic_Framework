/dts-v1/;

#include <st/f4/stm32f401Xe.dtsi>
#include <st/f4/stm32f401r(d-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
    model = "STM32_f401_dev board";
    compatible = "st,stm32_f401_dev";

    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,display = &ssd1306;
    };

    aliases {
        led0 = &user_led;
        sw0 = &user_button0;
        sw1 = &user_button1;
    };

    leds {
        compatible = "gpio-leds";

        user_led: led-1 {
            gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
            label = "LD";
        };
    };

    gpio_keys {
        compatible = "gpio-keys";

        user_button0: button-1 {
            gpios = <&gpioc 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_0>;
            label = "KEY0";
        };

        user_button1: button-2 {
            gpios = <&gpioc 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_1>;
            label = "KEY1";
        };
    };

    led_strip {
        compatible = "led-strip-container";

        user_ws2812_1: ws2812_1 {
            compatible = "worldsemi_ws2812_pwm";
            pwms = <&pwm5 3 1250 PWM_POLARITY_NORMAL>;
            dmas = <&dma1 0 6 STM32_DMA_PERIPH_TX STM32_DMA_16BITS>;
            dma-names = "update";
            chain-length = <1>;
            color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
            zero-pulse-ns = <420>;
            one-pulse-ns = <830>;
            reset-delay = <80>;
        };
    };

    /* PWM 蜂鸣器:TIM9_CH2 -> PA3。
     * pwms 的周期是文档性默认值(压电片的共振频率,驱动运行时会按请求的音调覆盖) */
    buzzer: buzzer {
        compatible = "pwm-buzzer";
        pwms = <&pwm9 2 PWM_HZ(2700) PWM_POLARITY_NORMAL>;
    };

    /* 软件 I2C(bit-bang):F401 的 PB0/PB1 无硬件 I2C 复用,走 GPIO 位带。
     * SDA/SCL 配成开漏 + 内部上拉;若 MPU6050 模块自带外部上拉则更好。 */
    i2c_gpio_0: i2c_gpio_0 {
        compatible = "gpio-i2c";
        #address-cells = <1>;
        #size-cells = <0>;
        scl-gpios = <&gpiob 0 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        sda-gpios = <&gpiob 1 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        clock-frequency = <100000>;     /* 100kHz */
        status = "okay";

        mpu6050: mpu6050@68 {
            compatible = "tdk,mpu6050";
            reg = <0x68>;     /* AD0 接 GND */
            status = "okay";
        };
    };
};

&clk_lsi {
    status = "okay";
};

&clk_hse {
    clock-frequency = <DT_FREQ_M(25)>; /* 25MHz passive crystal */
    status = "okay";
};

&pll {
    div-m = <25>;
    mul-n = <336>;
    div-p = <4>;
    div-q = <7>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(84)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <2>;
    apb2-prescaler = <1>;
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

/* 硬件 USART6:MCU TX=PC6(AF8) -> 模块 RXD,MCU RX=PC7(AF8) <- 模块 TXD。
 * 注意方向:模块的 TX 脚接 MCU 的 RX 脚。115200 8N1 是 KT6368A 出厂默认。 */
&usart6 {
    pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";

    kt6368a: kt6368a {
        compatible = "qinyue,kt6368a";
        status = "okay";
        /* 模块 STA 状态脚 -> PC5:已连接输出高电平,未连接为低电平(实测)。
         * 厂商资料称部分批次未连接时以 10Hz 脉冲输出,肉眼不可辨。 */
        sta-gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
    };
};

/* SD 卡:SDIO 4-bit 总线,D0=PC8 D1=PC9 D2=PC10 D3=PC11 CK=PC12 CMD=PD2,
 * 全部 AF12,pinctrl 节点在 stm32f401r(d-e)tx-pinctrl.dtsi 里现成提供
 * (含上拉和 very-high-speed)。SDIO 内核时钟取自 PLL_Q,当前时钟树
 * (HSE 25MHz,M=25,N=336,Q=7 -> VCO 336MHz)下 PLL_Q 恰为 48MHz,
 * 满足驱动的 48MHz 检查,无需改时钟配置。F401 无卡检测引脚,未接
 * cd-gpios,卡未插时挂载会失败。 */
&sdmmc1 {
    status = "okay";
    pinctrl-0 = <&sdio_d0_pc8 &sdio_d1_pc9 &sdio_d2_pc10
                 &sdio_d3_pc11 &sdio_ck_pc12 &sdio_cmd_pd2>;
    pinctrl-names = "default";
    bus-width = <4>;
    disk-name = "SD";
    /* 传输阶段总线时钟 = 48MHz/(clk-div+2) = 24MHz(分母最小为 2,已是
     * 硬件上限;clk-bypass 可到 48MHz,但默认速度模式卡规范上限 25MHz,
     * 且本驱动不做 CMD6 高速模式切换,超规不可用)。贴 25MHz 上限跑,
     * 飞线若出现 sd read/write error(CRC)则退回 3(≈9.6MHz)。
     * 注意识别阶段(CMD0)固定 400kHz,不受此属性影响。 */
    clk-div = <0>;
};

&i2c1 {
    pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    status = "okay";

    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <0x3f>;
        segment-remap;
        prechargep = <0x22>;
        /* 开启软件复位*/
        softreset-on;
    };
};

/* 硬件 I2C2:SCL=PB10(AF4), SDA=PB3(AF9)。
 * 注意 PB3 复位态是 JTDO/SWO 调试引脚,复用为 I2C 后 SWO 不可用,
 * SWD 下载/调试(PA13/PA14)不受影响。 */
&i2c2 {
    pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb3>;
    pinctrl-names = "default";
    status = "okay";

    qmc5883l: qmc5883l@0d {
        compatible = "qst,qmc5883l";
        reg = <0x0d>;     /* QMC5883L 固定 7 位地址 0x0D */
        status = "okay";
    };

    sht30: sht30@44 {
        compatible = "sensirion,sht30";
        reg = <0x44>;
        status = "okay";
    };

    bmp280: bmp280@76 {
        compatible = "bosch,bmp280";
        reg = <0x76>;     /* SDO 接 GND 为 0x76,接 VDDIO 为 0x77 */
        status = "okay";
    };
};

&timers5 {
	status = "okay";

	pwm5: pwm {
		status = "okay";
		pinctrl-0 = <&tim5_ch3_pa2>;
		pinctrl-names = "default";
	};
};

&timers9 {
	status = "okay";

	pwm9: pwm {
		status = "okay";
		pinctrl-0 = <&tim9_ch2_pa3>;
		pinctrl-names = "default";
	};
};

&dma1 {
	status = "okay";
};

&spi2 {
    pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
    pinctrl-names = "default";
    cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
    status = "okay";

    w25q128: w25q128@0 {
        compatible = "winbond,w25q128";
        reg = <0>;
        spi-max-frequency = <40000000>;
        size = <0x8000000>;     //128Mbit
        spi-cpol;               // 1
        spi-cpha;               // 1
        status = "okay";
    };
};