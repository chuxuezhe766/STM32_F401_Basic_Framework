CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y
# Enable MPU
CONFIG_ARM_MPU=y
# OLED (SSD1312)
CONFIG_I2C=y
CONFIG_DISPLAY=y
CONFIG_CHARACTER_FRAMEBUFFER=y
CONFIG_HEAP_MEM_POOL_SIZE=4096
# 主线程栈默认1024不够,曾致栈溢出崩溃
CONFIG_MAIN_STACK_SIZE=4096
# 栈溢出提前检测与线程名(崩溃日志可读)
CONFIG_STACK_SENTINEL=y
CONFIG_THREAD_NAME=y